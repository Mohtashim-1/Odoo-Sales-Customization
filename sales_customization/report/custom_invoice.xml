                                        <div class="col-5 text-right pr-4">
                                            <strong>NET WEIGHT IN KGS</strong>
                                            <br />
                                            <span t-esc="'{:.0f}'.format(doc.total_net_weight)" />
                                        </div>

                                        <!-- GROSS WEIGHT -->
                                        <div class="col-5 text-left pl-4">
                                            <strong>GROSS WEIGHT IN KGS</strong>
                                            <br />
                                            <span t-esc="'{:.0f}'.format(doc.total_gross_weight)" />
                                        </div>
                                    </div>
                                </div>
