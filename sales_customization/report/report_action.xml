            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">10</field>
            <field name="margin_bottom">10</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="header_line" eval="False" />
            <field name="header_spacing">10</field>
            <field name="dpi">90</field>
        </record>

        <record id="id_sales_customization_report" model="report.paperformat">
    <field name="name">A4 - Sales Order Custom Report</field>
    <field name="default" eval="True"/>
    <field name="format">A4</field>  
    <field name="orientation">Portrait</field>

    <field name="margin_top">60</field>  <!-- Reduce this from 40 to 10 -->
    <field name="margin_bottom">25</field>
    <field name="margin_left">10</field>
    <field name="margin_right">10</field>

    <field name="header_spacing">30</field>  <!-- Ensure header has minimal spacing -->
    <field name="dpi">90</field>
</record>

        <record id="id_sales_customization_proforma" model="report.paperformat">
            <field name="name">A4 - Proforma Invoice</field>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <!-- Letterhead ~30mm; minimal header HTML (no Odoo chrome) keeps it flush at top. -->
            <field name="margin_top">32</field>
            <field name="margin_bottom">25</field>
            <field name="margin_left">10</field>
            <field name="margin_right">10</field>
            <field name="header_spacing">0</field>
            <field name="dpi">90</field>
            <field name="disable_shrinking" eval="True"/>
        </record>





