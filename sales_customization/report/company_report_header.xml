<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_company_header">
        <t t-set="company_name" t-value="company.name or ''"/>
        <t t-set="is_mtj_company" t-value="company_name == 'MTJ' or company_name.startswith('MTJ ')"/>
        <t t-if="is_mtj_company and company.image_field_1">
            <div style="position: fixed; top: 42px; right: 30px; z-index: 1000;">
                <img t-att-src="image_data_uri(company.image_field_1)"
                     alt="Company Logo"
                     style="width: 120px; height: auto; display: block;"/>
            </div>
            <div style="height: 82px;"></div>
        </t>
        <t t-elif="company.image_field_1">
            <div class="header" style="text-align: center; margin-bottom: 30px;">
                <img t-att-src="image_data_uri(company.image_field_1)"
                     alt="Company Logo"
                     style="width: 100%; max-width: 210mm; height: 30mm; display: block; margin: 0 auto;"/>
            </div>
        </t>
    </template>

    <template id="report_company_footer">
        <t t-set="company_name" t-value="company.name or ''"/>
        <t t-set="is_mtj_company" t-value="company_name == 'MTJ' or company_name.startswith('MTJ ')"/>
        <t t-if="is_mtj_company and company.image_field_2">
            <div style="position: fixed; bottom: 0; left: 0; width: 100%; text-align: center; z-index: 1000;">
                <img t-att-src="image_data_uri(company.image_field_2)"
                     alt="Footer Logo"
                     style="width: 100%; max-width: 240mm; height: auto; display: block; margin: 0 auto;"/>
            </div>
        </t>
    </template>
</odoo>
