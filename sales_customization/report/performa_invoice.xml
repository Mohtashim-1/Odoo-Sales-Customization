                        <strong>Date:</strong>
                      </td>
                      <td style="width: 20%">
                        <span t-esc="doc.date_order.strftime('%d-%m-%Y')"/>
                      </td>
                    </tr>
                    <tr>
                      <td style="width: 20%">
                        <strong>Valid Till Date:</strong>
                      </td>
                      <td style="width: 20%">
                        <span t-esc="doc.validity_date.strftime('%d-%m-%Y')"/>
                      </td>
                    </tr>
                    <tr>
                      <td style="width: 20%">
                        <strong>Total Quantity</strong>
                      </td>
                      <td style="width: 20%">
                        <span t-esc="'{:.0f}'.format(doc.total_qty)" />
                      </td>
                    </tr>
                    <tr>
                      <td style="width: 20%">
                        <strong>Total Net Weight:</strong>
                      </td>
                      <td style="width: 20%">
                        <span t-esc="'{:.0f}'.format(doc.total_net_weight)" />
 Kg</td>
                    </tr>
                    <tr>
                      <td style="width: 20%">
                        <strong>Total Gross Weight:</strong>
                      </td>
                      <td style="width: 20%">
                        <span t-esc="'{:.0f}'.format(doc.total_gross_weight)" />
