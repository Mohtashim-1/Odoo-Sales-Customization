            <div class="header" style="margin-bottom: 30px;">
    <t t-if="doc.company_id.name == 'Eastern Products (Pvt.) Ltd.'">
        <div style="display: flex; justify-content: flex-end; align-items: center;">
            <div style="text-align: right;">
                <img t-if="doc.company_id.image_field_1" 
                     t-att-src="image_data_uri(doc.company_id.image_field_1)" 
                     alt="Company Logo" 
                     style="max-width: 210mm; max-height: 30mm; object-fit: contain;" />
            </div>
        </div>
    </t>
    <t t-if="doc.company_id.name != 'Eastern Products (Pvt.) Ltd.'">
        <div style="text-align: center;">
            <img t-if="doc.company_id.image_field_1" 
                 t-att-src="image_data_uri(doc.company_id.image_field_1)" 
                 alt="Company Logo" 
                 style="width: 100%; max-width: 210mm; height: 30mm; object-fit: contain;" />
        </div>
    </t>
</div>


