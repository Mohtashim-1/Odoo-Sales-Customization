<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <template id="report_performa_invoice">
      <t t-call="web.html_container">
        <t t-foreach="docs" t-as="doc">
          <style>

            <!-- .footer img {
                        width: 50%;
                        max-width: 210mm;
                        height: auto;
                    } -->
                    table {
                        border: 1px solid black;
                        width: 100%;
                        border-collapse: collapse;
                    }
                    th, td {
                        padding: 8px;
                        text-align: left;
                        border: 1px solid black;
                    }
                    .header img {
                        width: 100%;
                        height: auto;
                    }

          </style>
          <div class="page" style="font-family: Arial, sans-serif; margin: 0; padding: 30px;">
            <!-- Header Section -->
            <div class="header" style="text-align: center; margin-bottom: 30px;">
              <div>
                <img t-if="doc.company_id.image_field_1" t-att-src="image_data_uri(doc.company_id.image_field_1)" alt="Company Logo" style="width: 100%; max-width: 210mm; height: 30mm;" />
              </div>
              <div >
                <!-- <h1 style="font-size: 24px; font-weight: bold;">PROFORMA INVOICE</h1> -->
                <!-- <h3>Invoice No. <span t-esc="doc.name" /></h3> -->
              </div>
            </div>



            <div class="footer">
              <img t-if="doc.company_id.image_field_2" t-att-src="image_data_uri(doc.company_id.image_field_2)" alt="Footer Logo" style="width: 100%; max-width: 240mm; height: auto; margin-bottom: 20px !important;" />
            </div>


            <h1 style="font-size: 24px; font-weight: bold;">Proforma Invoice/ Sales Contract</h1>


             <table style="width: 100%; border-spacing: 0;">
    <tr>
        <!-- Left Column: Consignee Information -->
        <td style="width: 48%; vertical-align: top; padding-right: 5%;"> <!-- Added 5% right padding -->
            <table style="width: 100%; border-spacing: 0;">
                <tr>
                    <td colspan="2" t-att-style="'background-color: %s; color: %s; vertical-align: middle; width: 45px;' % (doc.company_id.name == 'Vital Products (Pvt.) Ltd.' and '#0b7b3e' or '#fdb913', doc.company_id.name == 'Vital Products (Pvt.) Ltd.' and 'white' or 'black')">
                        <strong>Consignee:</strong>
                    </td>
                </tr>
                <tr>
                    <td style="width: 40%; padding-top: 10px;"><strong>Invoice No:</strong></td>
                    <td style="width: 60%; padding-top: 10px;"> <span t-esc="doc.pi_no"/></td>
                </tr>
                <tr>
                    <td style="width: 40%;"><strong>Consigned To:</strong></td>
                    <td style="width: 60%;"><span t-field="doc.partner_shipping_id.display_name" /></td>
                </tr>
                <tr>
                    <td><strong>Consigned Address:</strong></td>
                    <td><span t-esc="doc.partner_shipping_id.street"/></td>
                </tr>
                <tr>
                    <td><strong>Country:</strong></td>
                    <td><span t-esc="doc.partner_shipping_id.country_id.name"/></td>
                </tr>
                <tr>
                    <td><strong>City:</strong></td>
                    <td><span t-esc="doc.partner_shipping_id.city"/></td>
                </tr>
                <tr>
                    <td><strong>POL:</strong></td>
                    <td><span t-field="doc.destination" /></td>
                </tr>
                <tr>
                    <td><strong>POD:</strong></td>
                    <td><span t-field="doc.delivery" /></td>
                </tr>
                <tr>
                    <td><strong>FDA:</strong></td>
                    <td><span t-field="doc.fda" /></td>
                </tr>
            </table>
        </td>

        <!-- Spacer Column (Adding 5% space between columns) -->
        <td style="width: 1%;"></td>

        <!-- Right Column: Shipping Details -->
        <td style="width: 50%; vertical-align: top;">
            <table style="width: 100%; border-spacing: 0;">
                <tr>
                    <td colspan="2" t-att-style="'background-color: %s; color: %s; vertical-align: middle; width: 45px;' % (doc.company_id.name == 'Vital Products (Pvt.) Ltd.' and '#0b7b3e' or '#fdb913', doc.company_id.name == 'Vital Products (Pvt.) Ltd.' and 'white' or 'black')">
                        <strong>Shipping Details:</strong>
                    </td>
                </tr>
                <tr style="margin-top: 50px !important;">
                    <td style="padding-top: 10px;"><strong>Date:</strong></td>
                    <td style="padding-top: 10px;"><span t-esc="doc.date_order.strftime('%d-%m-%Y')"/></td>
                </tr>
                <tr>
                    <td><strong>Valid Till Date:</strong></td>
                    <td><span t-esc="doc.validity_date.strftime('%d-%m-%Y')"/></td>
                </tr>
                <tr>
                    <td><strong>Total Cartons</strong></td>
                    <td><span t-esc="'{:.0f}'.format(doc.total_qty)" /></td>
                </tr>
                <tr>
                    <td><strong>Total Net Weight:</strong></td>
                    <td><span t-esc="'{:.0f}'.format(doc.total_net_weight)" /> Kg</td>
                </tr>
                <tr>
                    <td><strong>Total Gross Weight:</strong></td>
                    <td><span t-esc="'{:.0f}'.format(doc.total_gross_weight)" /> Kg</td>
                </tr>
                <tr>
                    <td><strong>Total CBM:</strong></td>
                    <td><span t-esc="'{:.0f}'.format(doc.total_order_cbm)" /></td>
                </tr>
            </table>
        </td>
    </tr>
</table>






            <!-- Products Table -->
            <div style=" font-size:11pt">
              <!-- <h3 style="font-size: 16px; font-weight: bold;">PAYMENT TERMS:</h3> -->
              <h3 style="font-size:11pt font-weight: bold;">Terms and Condition:</h3>
              <!-- <p>
        <strong>TERMS AND CONDITION:</strong>
      </p> -->
              <p style="margin: 0; padding: 0;">
      <strong>Payment Terms:</strong> <span t-field="doc.payment_term_id"/>
              </p>

              <p style="margin: 0; padding: 0;">
      15-20 Days after confirmation of order. Documents include: Commercial Invoice, Packing List, B/L, Phytosanitary  <span t-field="doc.payment_term_id"/>
              </p>

              <div style="margin-top: 20px; font-size:11pt padding-top: 10px;">
                <p style="margin: 0; padding: 0;"><strong>Destination: </strong><span t-field="doc.destination"/>
                </p>
                <p style="margin: 0; padding: 0;">SHIPMENT: WITHIN 25 DAYS AFTER RECEIPT OF SIGNED CONTRACT
                </p>
                <p style="margin: 0; padding: 0;">VALIDITY: THIS OFFER IS VALID UNTIL <span t-field="doc.validity"/>
                </p>
                <p style="margin: 0; padding: 0;">DOCUMENTS: B/L, COMMERCIAL INVOICE, PACKING LIST, PHYTOSANITARY CERTIFICATE, CERTIFICATE OF ORIGIN</p>
              </div>

            </div>

            <t t-if="doc.order_line">
              <!-- <h3 style="font-size: 16px; font-weight: bold;">PRODUCTS</h3> -->

              <table class="table table-condensed" style="width: 100%; border-collapse: collapse; margin-top: 10px; font-size:11pt">
                <thead>
                  <tr style="background-color: #C0C0C0;">
                    <th style="padding: 4px; border-bottom: 1px solid black;width:5px">S#</th>
                    <th style="padding: 4px; border-bottom: 1px solid black;">Image</th>

                    <th style="padding: 4px; border-bottom: 1px solid black;">Description</th>

                    <th style="padding: 4px; border-bottom: 1px solid black;">Packing</th>
                    <th style="padding: 4px; border-bottom: 1px solid black;">CTN(s)</th>
                    <th style="padding: 4px; border-bottom: 1px solid black;">Unit Price / CTN(s)</th>
                    <th style="padding: 4px; border-bottom: 1px solid black; text-align: right;">Amount</th>
                  </tr>
                </thead>
                <tbody>
                  <t t-set="sub_category_lst" t-value="[]" />
                  <t t-set="product_lst" t-value="[]" />
                  <t t-set="s_no" t-value="1" />

                  <!-- Grouped by Subcategories -->
                  <t t-foreach="doc.order_line" t-as="line">
                    <t t-if="line.product_id.categ_id.name not in sub_category_lst">
                      <t t-set="sub_category_lst" t-value="sub_category_lst + [line.product_id.categ_id.name]" />
                      <tr>
                        <td style="background-color:#DCDCDC" />
                        <td style="background-color:#DCDCDC" />
                        <td style="padding: 5px; background-color: #DCDCDC; text-align: left; vertical-align: middle; width: 150px;">
                          <strong>
                            <span t-esc="line.product_id.categ_id.name" />
                          </strong>
                        </td>
                        <td style="background-color:#DCDCDC" />
                        <td style="background-color:#DCDCDC" />
                        <td style="background-color:#DCDCDC" />
                        <td style="background-color:#DCDCDC" />

                      </tr>

                      <!-- Product Rows -->
                      <t t-foreach="doc.order_line" t-as="sub_line">
                        <t t-if="sub_line.product_id.categ_id.name == line.product_id.categ_id.name and sub_line.product_id.id not in product_lst">
                          <t t-set="product_lst" t-value="product_lst + [sub_line.product_id.id]" />
                          <tr>
                            <td style="padding: 8px; border-bottom: 1px solid lightgrey; text-align: center; vertical-align: top;">
                              <span t-esc="s_no" />
                              <t t-set="s_no" t-value="s_no + 1" />
                            </td>
                           <td style="padding: 8px; border-bottom: 1px solid lightgrey; text-align: center; vertical-align: middle; width: 40px; height: 40px;">
    <div style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 5px; background-color: #f9f9f9;">
        <img 
            t-if="sub_line.image" 
            t-att-src="image_data_uri(sub_line.image)" 
            alt="Product Image" 
            style="max-width: 100%; max-height: 100%; object-fit: contain; border-radius: 5px;" 
        />
    </div>
</td>




                            <td style="padding: 8px; border-bottom: 1px solid lightgrey; text-align: left;vertical-align: top;">
                              <span t-esc="sub_line.product_id.name" />

                              <!-- <span t-esc="sub_line.product_uom_qty" /> -->
                            </td>
                            <td style="padding: 8px; border-bottom: 1px solid lightgrey; text-align: right;vertical-align: top;">
                              <t t-esc="sub_line.packaging_detail_id.display_name" />

                            </td>
                            <td style="padding: 8px; border-bottom: 1px solid lightgrey; text-align: center;vertical-align: top;">
                              <span t-esc="'{:.0f}'.format(sub_line.product_uom_qty)" />
                            </td>
                            <td style="padding: 8px; border-bottom: 1px solid lightgrey; text-align: center; width: 10%;vertical-align: top;">
                              <!-- <span t-esc="sub_line.price_unit" /> -->
                              $                              <span t-esc="'{:.2f}'.format(sub_line.price_unit)" />
                            </td>
                            <td style="padding: 8px; border-bottom: 1px solid lightgrey; text-align: right; width: 13%;vertical-align: top;">
    $                              <span t-esc="'{:.2f}'.format(sub_line.price_subtotal)" />
                            </td>

                          </tr>
                        </t>
                      </t>
                    </t>
                  </t>
                </tbody>
                <!-- <tfoot>
                  <tr>
                    <td colspan="2" style="padding: 4px; border: 1px solid black;">
                   
                      <span t-esc="'{:.0f}'.format(doc.total_qty)" />
 CARTONS
                                                       
                    </td>
                    <td colspan="4" style="padding: 4px; border: 1px solid black; text-align: right;">
                      <strong>TOTAL FOB VALUE IN USD $ :</strong>
                    </td>
                    <td style="padding: 4px; border: 1px solid black; text-align: right;">
                      <span t-esc="'{:.2f}'.format(doc.total)" />

                    </td>
                  </tr>
                </tfoot> -->
              </table>
            </t>
<br/><br/>

<table style="width: 100%; font-size: 11pt; border-collapse: collapse;">
  <tr>
    <!-- Left Section: Bank Details -->
    <td style="width: 50%; vertical-align: top; padding-right: 20px;">
      <h3 style="font-size: 11pt; font-weight: bold; margin-bottom: 5px;">Seller Bank Details:</h3>
      <table style="width: 100%; border-collapse: collapse;">
        <t t-if="doc.company_id.name == 'Vital Products (Pvt.) Ltd.'">
          <tr><td><strong>BANK:</strong></td><td>Meezan Bank Limited</td></tr>
          <tr><td><strong>BRANCH:</strong></td><td>Shahrah-e-Faisal Karachi</td></tr>
          <tr><td><strong>ACCOUNT TITLE:</strong></td><td>M/S VITAL PRODUCTS PVT. LTD</td></tr>
          <tr><td><strong>ACCOUNT NO:</strong></td><td>01110104778802</td></tr>
          <tr><td><strong>SWIFT CODE:</strong></td><td>MEZNPKKAXXX</td></tr>
          <tr><td><strong>IBAN#:</strong></td><td>PK02MEZN0001110104778802</td></tr>
        </t>
        <t t-else="">
          <tr><td><strong>BANK:</strong></td><td>Meezan Bank Limited</td></tr>
          <tr><td><strong>BRANCH:</strong></td><td>Shahrah-e-Faisal Karachi</td></tr>
          <tr><td><strong>ACCOUNT TITLE:</strong></td><td>M/S Eastern Products Pvt. Ltd</td></tr>
          <tr><td><strong>ACCOUNT NO:</strong></td><td>0104507174</td></tr>
          <tr><td><strong>SWIFT CODE:</strong></td><td>MEZNPKKAXXX</td></tr>
          <tr><td><strong>IBAN#:</strong></td><td>PK79MEZN0001110104507174</td></tr>
        </t>
      </table>
    </td>

    <!-- Right Section: Financial Details -->
    <td style="width: 50%; vertical-align: top; text-align: right; padding-left: 20px; ">
      <div style="width: 100%; margin-bottom: 10px;"></div>
      <table style="width: 100%; text-align: right; border-collapse: collapse;">
        <tr>
          <td><strong>Net FOB Value in USD:</strong></td>
          <td>$ <t t-esc="'{:.2f}'.format(doc.amount_total)"></t></td>
        </tr>
        <tr>
          <td><strong>Freight:</strong></td>
          <td>$ <t t-esc="'{:.2f}'.format(doc.freight)" /></td>
        </tr>
        <tr>
          <td><strong>Credit Note:</strong></td>
          <td><!-- <t t-esc="'{:.2f}'.format(doc.credit_note)" /> --></td>
        </tr>
        <tr>
          <td>
            <strong>
              <t t-if="doc.freight and doc.freight > 0">Net CNF Value in USD:</t>
              <t t-else="">Net FOB Value in USD:</t>
            </strong>
          </td>
          <td>$ <t t-esc="'{:.2f}'.format(doc.total)" /></td>
        </tr>
      </table>
    </td>
  </tr>
</table>




          <div style="page-break-inside: avoid;">

            <!-- Bank Details Section -->
           
            <!-- <div style="margin-top: 20px; font-size:11pt padding-top: 10px;">
              <p style="margin: 0; padding: 0;">Destination: <span t-field="doc.destination"/>
              </p>
              <p style="margin: 0; padding: 0;">SHIPMENT: WITHIN 25 DAYS AFTER RECEIPT OF SIGNED CONTRACT
              </p>
              <p style="margin: 0; padding: 0;">VALIDITY: THIS OFFER IS VALID UNTIL <span t-field="doc.validity"/>
              </p>
              <p style="margin: 0; padding: 0;">DOCUMENTS: B/L, COMMERCIAL INVOICE, PACKING LIST, PHYTOSANITARY CERTIFICATE, CERTIFICATE OF ORIGIN</p>
            </div> -->


            <!-- Seller Bank Details Section -->
            





            
<table style="width: 100%; table-layout: fixed; border-collapse: collapse;">
    <tr>
        <!-- Left Column -->
        <td style="width: 40%; text-align: center; vertical-align: bottom;">
            <img 
                t-if="doc.company_id.image_field_3" 
                t-att-src="image_data_uri(doc.company_id.image_field_3)" 
                alt="Signature" 
                style="width: 65%; height: auto; object-fit: contain;" 
            />
            <br/>
            <p style="border-top: 1px solid black; width: 100%; margin-top: 5px;"></p>
        </td>

        <!-- Center Column (Spacer) -->
        <td style="width: 20%;"></td>

        <!-- Right Column -->
        <td style="width: 40%; text-align: center; vertical-align: bottom;">
            <p style="border-top: 1px solid black; width: 100%; margin-top: 5px;"></p>
        </td>
    </tr>
    
    <tr>
        <!-- Footer -->
        <td style="width: 40%; text-align: left;">
            <strong>Eastern Product (PVT.) LTD.</strong>
        </td>
        <td style="width: 20%;"></td>
        <td style="width: 40%; text-align: right;">
            <strong><span t-field="doc.partner_id.name"></span></strong>
        </td>
    </tr>
</table>



          </div>



        </div>
      </t>
    </t>
  </template>
</data>
</odoo>