    <template id="report_performa_invoice">
      <t t-call="web.html_container">
        <t t-foreach="docs" t-as="doc">
          <style>
                    
                    .footer img {
                        width: 50%;
                        max-width: 210mm;
                        height: auto;
                    }
                    table {
                        border: 1px solid black;
                        width: 100%;
                        border-collapse: collapse;
                    }
                    th, td {
