                </td>

                <td style="width: 50%;">
                  <table>
                    <tr>
                      <!-- <td colspan="2" style="background-color: #fdb913;"><strong>Shipping Details:</strong></td> -->
                      <td colspan="2" t-att-style="'background-color: %s; color: %s;' % (doc.company_id.name == 'Eastern Products (Pvt.) Ltd.' and '#fdb913' or '#0b7b3e', doc.company_id.name == 'Eastern Products (Pvt.) Ltd.' and 'white' or 'black')">
                        <strong>Shipping Details:</strong>
                      </td>


                    </tr>
