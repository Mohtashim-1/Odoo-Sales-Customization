              <table style="width: 100%; table-layout: fixed;">
                <tr>
                  <!-- Left Column -->
                  <td style="width: 40%; text-align: left;">
                    <img t-if="doc.company_id.image_field_3" t-att-src="image_data_uri(doc.company_id.image_field_3)" alt="Signature" style="width: 75%; height: 100px; object-fit: contain;" />
                    <p style="border-top: 1px solid black; text-align: right; width: 100%;  "></p>
                  </td>

                  <!-- Center Column -->
                  <td style="width: 20%;"></td>

                  <!-- Right Column -->
                  <td style="width: 40%; text-align: right;">
                    <div style="height: 100px;"></div>                    <!-- Placeholder for height consistency -->
                    <p style="border-top: 1px solid black; text-align: right; width: 100%;"></p>
                  </td>
                </tr>
                <tr>
                  <!-- Footer -->
                  <td style="width: 40%; text-align: center;">
                    <strong style="display: block; ">Eastern Product (PVT.) LTD.</strong>
                  </td>
                  <td style="width: 20%;"></td>
                  <td style="width: 40%; text-align: center;">
                    <strong style="display: block;">
                      <span t-field="doc.partner_id.name" />
                    </strong>
                  </td>
                </tr>
              </table>

            </div>






