                    </tr>
                    <tr>
                      <td style="width: 20%">
                        <strong>Total CBM:</strong>
                      </td>
                      <td style="width: 20%">

                        <span t-esc="'{:.0f}'.format(doc.total_cbm)" />
                      </td>
                    </tr>
                    <tr>
                      <td style="width: 20%; visibility: hidden;">
                        <strong>CBM Left for 40 FCL Container</strong>
                      </td>
                      <td style="width: 20%; visibility: hidden;">
