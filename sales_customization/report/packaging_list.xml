<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="packaging_list" name="Commercial Invoice Report" t-name="sales_customization.packaging_list">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                <style>
                    .footer {
                        position: fixed;
                        bottom: 0;
                        left: 0;
                        width: 100%;
                        text-align: center;
                        font-size: 12px;
                        padding: 10px;
                        border-top: 1px solid #000;
                        z-index: 999;
                    }
                    .footer img {
                        width: 100%;
                        max-width: 210mm;
                        height: auto;
                    }
                    table {
                        border: 1px solid black;
                        width: 100%;
                        border-collapse: collapse;
                    }
                    th, td {
                        padding: 8px;
                        text-align: left;
                        border: 1px solid black;
                    }
                    .header img {
                        width: 100%;
                        height: auto;
                    }
                </style>

                    <div class="page" style="font-family: Arial, sans-serif; margin: 0;">
                        <!-- Header Section -->
                        <div class="header" style="text-align: center; margin: 0; padding: 0;">
                            <div>
                                <img t-if="doc.company_id.image_field_1" t-att-src="image_data_uri(doc.company_id.image_field_1)" alt="Company Logo" style="width: 100%; max-width: 210mm; height: 30mm;" />
                            </div>
                        </div>

                        <!-- Custom Footer -->
                        <div class="footer">
                            <img t-if="doc.company_id.image_field_2" t-att-src="image_data_uri(doc.company_id.image_field_2)" alt="Footer Logo" 
                                 style="width: 100%; max-width: 240mm; height: auto;" />
                        </div>

                        <!-- Title Section -->
                        <div style="text-align: center; margin: 0; padding: 0;">
                            <h1 style="font-size: 24px; font-weight: bold; margin: 0;">PACKING LIST</h1>
                            
                        </div>

                        <!-- Products Table -->
                        <p>Invoice No.<span t-esc="doc.pi_no" /></p>
                        <table class="table table-condensed" style="width: 100%; border-collapse: collapse; margin-top: 0; border: 1px solid black;">
                            <thead style="background-color: #f4f4f4; font-weight: bold; text-align: left;">
                                <tr>
                                    <th style="padding: 8px; border: 1px solid black;">S.No.</th>
                                    <th style="padding: 8px; border: 1px solid black;">Image</th>
                                    <th style="padding: 8px; border: 1px solid black;">Description</th>
                                    <th style="padding: 8px; border: 1px solid black; text-align: center;">Packaging</th>
                                    <th style="padding: 8px; border: 1px solid black; text-align: center;">No. Of Ctn</th>
                                    <th style="padding: 8px; border: 1px solid black; text-align: center;">Qty</th>
                                </tr>
                            </thead>
                            <tbody style="font-size: 14px;">
                                <t t-set="product_lst" t-value="[]"/>
                                <t t-set="s_no" t-value="1"/>

                                <t t-foreach="doc.order_line" t-as="line">
                                    <t t-if="line.product_id.id not in product_lst">
                                        <t t-set="product_lst" t-value="product_lst + [line.product_id.id]"/>

                                        <tr>
                                            <td style="padding: 8px; border: 1px solid black;">
                                                <span t-esc="s_no"/>
                                                <t t-set="s_no" t-value="s_no+1"/>
                                            </td>
                                            <td style="padding: 8px; border: 1px solid black; text-align: center;">
                                                <img t-if="line.image" t-att-src="image_data_uri(line.image)" alt="Product Image" style="width: 40px; height: 40px;" />
                                            </td>
                                            <td style="padding: 8px; border: 1px solid black;">
                                                <span t-esc="line.name"/>
                                            </td>
                                            <td style="padding: 4px; border: 1px solid black; text-align: center;">
                                                <t t-esc="line.packaging_detail_id.display_name"/>
                                            </td>
                                            <td style="padding: 8px; border: 1px solid black; text-align: center;">
                                                <span t-esc="line.no_of_ctn"/>
                                            </td>
                                            <td style="padding: 8px; border: 1px solid black; text-align: center;">
                                                <span t-esc="'{:.0f}'.format(line.product_uom_qty)" />
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="2" style="padding: 4px; border: 1px solid black;">
                                       <strong><span t-field="doc.total_items" /> ITEMS</strong>
                                    </td>
                                    <td colspan="4" style="padding: 4px; border: 1px solid black; text-align: right;">
                                       <strong>CARTONS <span t-field="doc.total_qty" t-options='{"precision": 0}'/></strong>
                                    </td> 
                                </tr>
                            </tfoot>
                        </table>

                        <!-- Weight Information -->
                        <div style="margin-top: 20px;">
                            <table style="width: 100%; text-align: center;">
                                <tr>
                                    <!-- NET WEIGHT -->
                                    <td style="text-align: right; padding-right: 50px;">
                                        <strong>NET WEIGHT IN KGS</strong>
                                        <br />
                                        <span t-field="doc.total_net_weight" t-options='{"precision": 2}' />
                                    </td>

                                    <!-- GROSS WEIGHT -->
                                    <td style="text-align: left; padding-left: 50px;">
                                        <strong>GROSS WEIGHT IN KGS</strong>
                                        <br />
                                        <span t-field="doc.total_gross_weight" t-options='{"precision": 2}' />
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <!-- Additional Information Section -->
                        <div style="margin-top: 30px;">
                            <h4 style="font-size: 16px; font-weight: bold;">DECLARATION:</h4>
                            <ul style="font-size: 14px; line-height: 1.6;">
                                <li>
                                    <strong>The container(s) covered by this document has/have been cleaned and is/are free from material of animal and/or plant origin and soil &amp; is free from KHAPRA BEETLE insect.</strong>
                                </li>
                            </ul>
                        </div>
                    </div>
                </t>
            </t>
        </template>
    </data>
</odoo>
