<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="commercial_invoice_report1" name="Commercial Invoice Report" t-name="sales_customization.commercial_invoice_report1">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <style>
                    .footer img {
                        width: 100%;
                        max-width: 210mm;
                        height: auto;
                    }
                    table {
                        width: 100%;
                        border-collapse: collapse;
                    }
                    th, td {
                        padding: 8px;
                        text-align: left;
                        border: none;
                    }
                    /* Kill Bootstrap .table grid so borders match Proforma (row lines only) */
                    .table, .table > :not(caption) > * > * {
                        border: none !important;
                        border-width: 0 !important;
                    }
                    .header.company-letterhead img {
                        width: 100%;
                        height: auto;
                    }
                </style>
                    <div class="page" style="font-family: Arial, sans-serif; margin: 0; padding: 5px 30px 30px 30px;">
                        <!-- Header Section -->
                        <t t-call="sales_customization.report_company_header">
                            <t t-set="company" t-value="doc.company_id"/>
                        </t>

                        
            <div class="footer" style="margin: 0; padding: 0; line-height: 0; font-size: 0;">
    <img t-if="doc.company_id.image_field_2" t-att-src="image_data_uri(doc.company_id.image_field_2)" alt="Footer Logo" 
         style="width: 100%; max-width: 100%; height: auto; display: block; margin: 0; padding: 0;" />
</div>

                        <!-- <div style="text-align: center;">
                            
                        </div> -->
                        <!-- <br/><br/>
                             <br/><br/>
                             <br/><br/> -->

                        <div style=" text-align: center;">
                                <h1 style="font-size: 24px; font-weight: bold;">EXPORT ORDER</h1>
                                <p style="font-size: 11px; margin-top: 2px;">Grouped by export category tag — set tags on the order and on each product.</p>
                            </div>
                        <table style="width:100%; margin-top:20px; border-spacing: 0; font-size:11pt">
                            <!-- <tr>
                                <td>
                                    CARTONS OF VITAL TEA: 
                                </td>
                                <td t-esc="doc.total_qty"/>
                            </tr>
                            <tr>
                                <td>
                                SHIPPED IN SOUND CONDITION
                               </td>
                            <td>VOYAGE NO.</td>
                            <td t-esc="doc.voyage"/>
                        </tr> -->
                            <tr>
                                <td>
                                  <strong>Dated: </strong>

                                </td>
                                <td>
                                <span t-esc="doc.date_order and doc.date_order.strftime('%d-%m-%Y') or ''"/>
                                </td>
                                <td>
                                    <strong>Order No:</strong>
                                </td>
                                <td >
                                <t t-esc="doc.pi_no"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                  <strong> Name of Buyer: </strong>
                                </td>
                                <td>

                                    <t t-esc="doc.partner_id.name"/>

                                </td>
                                <td>
                                    <strong>Container CBM: </strong>
                                </td>
                                <td >
                                <t t-esc="doc.container_cbm"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                  <strong> Destination: </strong>
                                </td>
                                <td >

                                    <t t-esc="doc.destination"/>

                                </td>
                                <td>
                                    <strong>Delivery: </strong>
                                </td>
                                <td >

                                    <t t-esc="doc.delivery"/>


                                </td>
                            </tr>
                            <tr>
                                <td>
                                   <strong>Export Order Date:</strong>
                                </td>
                                <td>
                                    <span t-if="doc.order_date" t-esc="doc.order_date.strftime('%d-%m-%Y')"/>
                                </td>
                                <td>
                                    <strong>Container Arrival Date:</strong>
                                </td>
                                <td>
                                    <span t-if="doc.container_arrival_date" t-esc="doc.container_arrival_date.strftime('%d-%m-%Y')"/>
                                </td>
                            </tr>
                            


                        </table>

                        

                        <!-- Products Table -->
                        <table class="table table-condensed" style="width: 100%; border-collapse: collapse; margin-top: 20px; font-size:11pt">
                            <thead>
                                <tr style="background-color: #C0C0C0; font-weight: bold; text-align: left;">
                                    <th style="padding: 8px; border-bottom: 1px solid black;">S.No.</th>
                                    <th style="padding: 8px; border-bottom: 1px solid black;">Image</th>
                                    <th style="padding: 8px; border-bottom: 1px solid black;">Description</th>
                                    <th style="padding: 8px; border-bottom: 1px solid black;">Ctns</th>
                                    <th style="padding: 8px; border-bottom: 1px solid black;">Pkts</th>
                                    <th style="padding: 8px; border-bottom: 1px solid black;">Lbs Oz</th>
                                    <th style="padding: 8px; border-bottom: 1px solid black;">Packaging</th>
                                    <th style="padding: 8px; border-bottom: 1px solid black;">Status</th>
                                    <th style="padding: 8px; border-bottom: 1px solid black;">Description</th>
                                </tr>
                            </thead>
                            <tbody style="font-size:11pt">
                                <!-- <t t-foreach="enumerate(doc.order_line, start=1)" t-as="line">
                                    <tr>
                                        <td style="padding: 8px; border: 1px solid black;">
                                            <t t-esc="line[0]"/>
                                        </td>
                                        <td style="padding: 8px; border: 1px solid black;">
                                            <t t-esc="line[1].name"/>
                                        </td>
                                        <td style="padding: 8px; border: 1px solid black;">
                                            <t t-esc="line[1].ctn"/>
                                        </td>
                                        <td style="padding: 8px; border: 1px solid black;">
                                            <t t-esc="line[1].pkt"/>
                                        </td>
                                        <td style="padding: 8px; border: 1px solid black;">
                                            <t t-esc="line[1].packaging_detail_id.display_name"/>
                                        </td>
                                        <td style="padding: 8px; border: 1px solid black;">
                                            <t t-esc="line[1].status"/>
                                        </td>
                                        <td style="padding: 8px; border: 1px solid black;">
                                            <t t-esc="line[1].description"/>
                                        </td>
                                    </tr>
                                </t> -->

                                <!-- Allowed tag IDs from export_order_category_tags (products must have Export Category Tag set) -->
<t t-set="allowed_tag_ids" t-value="[]"/>
<t t-foreach="doc.export_order_category_tags" t-as="tg">
    <t t-set="allowed_tag_ids" t-value="allowed_tag_ids + [tg.id]"/>
</t>

<t t-set="tag_header_ids" t-value="[]"/>
<t t-set="product_lst" t-value="[]"/>
<t t-set="s_no" t-value="1"/>

<t t-foreach="doc.order_line" t-as="line">
    <t t-set="line_tag" t-value="line.product_id.product_tmpl_id.export_category_tag_id"/>
    <t t-if="line_tag and line_tag.id in allowed_tag_ids and line_tag.id not in tag_header_ids">
        <t t-set="tag_header_ids" t-value="tag_header_ids + [line_tag.id]"/>

        <tr>
            <td style="background-color:#EDEDED;" />
            <td style="background-color:#EDEDED;" />
            <td style="background-color:#EDEDED; font-weight: bold; text-align: left;">
                <span t-esc="line_tag.name"/>
            </td>
            <td style="background-color:#EDEDED;" />
            <td style="background-color:#EDEDED;" />
            <td style="background-color:#EDEDED;" />
            <td style="background-color:#EDEDED;" />
            <td style="background-color:#EDEDED;" />
            <td style="background-color:#EDEDED;" />
        </tr>

        <t t-foreach="doc.order_line" t-as="subline">
            <t t-set="sub_tag" t-value="subline.product_id.product_tmpl_id.export_category_tag_id"/>
            <t t-if="sub_tag and sub_tag.id == line_tag.id and subline.product_id.id not in product_lst">
                <t t-set="product_lst" t-value="product_lst + [subline.product_id.id]"/>

                <tr>
                    <td style="padding: 8px; border-bottom: 1px solid lightgrey; text-align: center; vertical-align: top;">
                        <span t-esc="s_no"/>
                        <t t-set="s_no" t-value="s_no + 1"/>
                    </td>
                    <td style="padding: 8px; border-bottom: 1px solid lightgrey; text-align: center; vertical-align: middle; width: 40px; height: 40px;">
                        <div style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 5px; background-color: #f9f9f9;">
                            <img 
                                t-if="subline.image" 
                                t-att-src="image_data_uri(subline.image)" 
                                alt="Product Image" 
                                style="max-width: 100%; max-height: 100%; object-fit: contain; border-radius: 5px;" 
                            />
                        </div>
                    </td>
                    <td style="padding: 8px; border-bottom: 1px solid lightgrey; text-align: left; vertical-align: top;">
                        <span t-esc="subline.name"/>
                    </td>
                    <td style="padding: 8px; border-bottom: 1px solid lightgrey; text-align: center; vertical-align: top;">
                        <t t-esc="int(subline.product_uom_qty)"/>
                    </td>
                    <td style="padding: 8px; border-bottom: 1px solid lightgrey; text-align: center; vertical-align: top;">
                        <span t-esc="'{:.0f}'.format(subline.pkts)"/>
                    </td>
                    <td style="padding: 8px; border-bottom: 1px solid lightgrey; text-align: center; vertical-align: top;">
                        <span t-esc="subline.lbs_oz"/>
                    </td>
                    <td style="padding: 8px; border-bottom: 1px solid lightgrey; text-align: center; vertical-align: top;">
                        <span t-esc="subline.packaging_detail_id.display_name"/>
                    </td>
                    <td style="padding: 8px; border-bottom: 1px solid lightgrey; text-align: left; vertical-align: top;">
                        <span t-esc="subline.status"/>
                    </td>
                    <td style="padding: 8px; border-bottom: 1px solid lightgrey; text-align: left; vertical-align: top;">
                        <span t-esc="subline.description"/>
                    </td>
                </tr>
            </t>
        </t>
    </t>
</t>


                                
                                <!-- Syed Owais Noor <-> ByteCode -->
                            </tbody>
                            <!-- <tfoot>
                                <tr>
                                    <td colspan="9" style="padding: 4px; border: 1px solid black;">
                                       <strong>TOTAL CARTONS</strong>    
                                        <span t-field="doc.total_qty" t-options='{"precision": 0}'/>

                                    </td>


                                </tr>
                            </tfoot> -->
                        </table>

                        

                        <br/>
                        <br/>
                        <p style="border-top: 1px solid black; text-align: right; width: 400px; margin-left: auto;"></p>
                        <table style="font-size:11pt">
                        <tr>
    <td style="width: 60%;"></td> <!-- Empty column for spacing -->
    <td style="width: 30%;" ><strong>Total Cartons :</strong></td>
    <td style="width: 10%; "></td>
    <td style="width: 10%; " ><span t-esc="'{:.2f}'.format(doc.total_qty)" /></td>
</tr>
   
                        </table>

                        <!-- Additional Information Section -->
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; font-size:11pt">
                            
                            <div>
                                <strong>Instruction:</strong><br/>
                                Foreign Language Instructions
                                <br />
                                 On Packets / Labels For Product's Name:
                                <span t-esc="doc.label_name"/>
                            </div>
                            <br/>
                            <div>
     Manufactory / Expiry / Best Before :
    <span t-if="doc.manufactory_date" t-esc="doc.manufactory_date.strftime('%d-%b-%Y')"/>
    <span t-if="doc.expiry_date" t-esc="doc.expiry_date.strftime('%d-%b-%Y')"/>
    <span t-if="doc.best_before" t-esc="doc.best_before.strftime('%d-%b-%Y')"/>
</div>

                        </div>
                        <br/>


                        <strong>Language of Nutrition Facts And Ingredient List:</strong>
                        <br/>
                        <div>
                            <strong>
                                <span> Print Instructions:</span>
                                <span t-esc="doc.print_instruction"/>
                            </strong>
                            <br/>
                            <span t-field="doc.partner_id.name"/>
                            <br/>
                            <span t-esc="doc.partner_shipping_id.street"/>
                            <span t-esc="doc.partner_shipping_id.city"/>
                            <span t-esc="doc.partner_shipping_id.country_id.name"/> 
                            <br/>
                            <strong>Contact:</strong> <span t-esc="doc.partner_id.phone"/>
                            <br/>
                            <strong> Best Before: </strong>      
                            <span t-if="doc.best_before" t-esc="doc.best_before.strftime('%d-%b-%Y')"/>
                            <br/>
                            <strong> Lot Code:  </strong> <span t-esc="doc.pi_no"/>

                    </div>

                    <br/>
                    <br/>

                    <table style="width: 100%; table-layout: fixed; font-size:11pt">
    <tr>
        <td style="width: 40%; text-align: left;">Prepared By: _______________</td>
        <td style="width: 20%;"></td>
        <td style="width: 40%; text-align: right;">Dated: __________________</td>
    </tr>
</table>

                    
                </div>
            </t>
        </t>
    </template>

        <!-- Legacy t-name: DB print actions / favourites may still reference this xml id -->
        <template id="commercial_invoice_report_category_tag" t-name="sales_customization.commercial_invoice_report_category_tag">
            <t t-call="sales_customization.commercial_invoice_report1"/>
        </template>
</data>
</odoo>
