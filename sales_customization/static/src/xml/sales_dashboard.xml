<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sales_customization.SalesDashboardAction">
        <t t-if="state.ready">
            <WithSearch t-props="state.withSearchProps">
                <t t-set-slot="default" t-slot-scope="search">
                    <SalesDashboard t-props="search"/>
                </t>
            </WithSearch>
        </t>
        <t t-else="">
            <div class="o_sales_dashboard_loading p-4">Loading dashboard...</div>
        </t>
    </t>

    <t t-name="sales_customization.SalesDashboard">
        <Layout display="display" className="'o_sales_dashboard_layout'">
            <t t-set-slot="layout-actions">
                <SearchBar autofocus="true"/>
            </t>
            <div class="o_sales_dashboard">
            <t t-if="state.loading">
                <div class="o_sales_dashboard_loading">Loading dashboard...</div>
            </t>
            <t t-else="">
                <div class="o_sales_dashboard_header">
                    <div>
                        <h1 class="o_sales_dashboard_title">Sales Dashboard</h1>
                        <t t-if="state.data.partner.name">
                            <div class="o_sales_dashboard_subtitle">Customer: <t t-esc="state.data.partner.name"/></div>
                        </t>
                        <div class="o_sales_dashboard_hint">Click a KPI or a chart value to see how that number is calculated.</div>
                    </div>
                </div>

                <div class="o_sales_kpis">
                    <div class="o_kpi" t-on-click="() => this.openKpiDetails('kpi_sale_orders')">
                        <div class="o_kpi_label">Sales Orders</div>
                        <div class="o_kpi_value"><t t-esc="state.data.kpis.sale_order_count"/></div>
                        <div class="o_kpi_sub"><t t-esc="formatCurrency(state.data.kpis.sale_order_total)"/></div>
                        <div class="o_kpi_sub">Last: <t t-esc="state.data.kpis.last_sale_date || '-'"/></div>
                    </div>
                    <div class="o_kpi" t-on-click="() => this.openKpiDetails('kpi_sale_invoices')">
                        <div class="o_kpi_label">Sales Invoices</div>
                        <div class="o_kpi_value"><t t-esc="state.data.kpis.sale_invoice_count"/></div>
                        <div class="o_kpi_sub"><t t-esc="formatCurrency(state.data.kpis.sale_invoice_total)"/></div>
                        <div class="o_kpi_sub">Last: <t t-esc="state.data.kpis.last_invoice_date || '-'"/></div>
                    </div>
                    <div class="o_kpi" t-on-click="() => this.openKpiDetails('kpi_old_sales')">
                        <div class="o_kpi_label">Historical (Old) Sales</div>
                        <div class="o_kpi_value"><t t-esc="state.data.kpis.old_sale_count"/></div>
                        <div class="o_kpi_sub"><t t-esc="formatCurrency(state.data.kpis.old_sale_total)"/></div>
                    </div>
                    <div class="o_kpi" t-on-click="() => this.openKpiDetails('kpi_paid')">
                        <div class="o_kpi_label">Paid Invoices</div>
                        <div class="o_kpi_value"><t t-esc="formatCurrency(state.data.kpis.invoice_paid_total)"/></div>
                        <div class="o_kpi_sub">Total Paid Amount</div>
                    </div>
                    <div class="o_kpi" t-on-click="() => this.openKpiDetails('kpi_open')">
                        <div class="o_kpi_label">Open Invoices</div>
                        <div class="o_kpi_value"><t t-esc="formatCurrency(state.data.kpis.invoice_open_total)"/></div>
                        <div class="o_kpi_sub">Outstanding Amount</div>
                    </div>
                    <div class="o_kpi" t-on-click="() => this.openKpiDetails('kpi_avg_order')">
                        <div class="o_kpi_label">Average Order Value</div>
                        <div class="o_kpi_value"><t t-esc="formatCurrency(state.data.kpis.avg_order_value)"/></div>
                    </div>
                    <div class="o_kpi" t-on-click="() => this.openKpiDetails('kpi_avg_invoice')">
                        <div class="o_kpi_label">Average Invoice Value</div>
                        <div class="o_kpi_value"><t t-esc="formatCurrency(state.data.kpis.avg_invoice_value)"/></div>
                    </div>
                    <div class="o_kpi" t-on-click="() => this.openKpiDetails('kpi_paid_pct')">
                        <div class="o_kpi_label">Paid %</div>
                        <div class="o_kpi_value"><t t-esc="formatPercent(state.data.kpis.paid_pct)"/></div>
                    </div>
                    <div class="o_kpi" t-on-click="() => this.openKpiDetails('kpi_open_pct')">
                        <div class="o_kpi_label">Open %</div>
                        <div class="o_kpi_value"><t t-esc="formatPercent(state.data.kpis.open_pct)"/></div>
                    </div>
                    <div class="o_kpi" t-on-click="() => this.openKpiDetails('kpi_refund_total')">
                        <div class="o_kpi_label">Credit Notes Total</div>
                        <div class="o_kpi_value"><t t-esc="formatCurrency(state.data.kpis.refund_total)"/></div>
                    </div>
                    <div class="o_kpi" t-on-click="() => this.openKpiDetails('kpi_refund_count')">
                        <div class="o_kpi_label">Credit Notes Count</div>
                        <div class="o_kpi_value"><t t-esc="formatNumber(state.data.kpis.refund_count)"/></div>
                    </div>
                    <div class="o_kpi" t-on-click="() => this.openKpiDetails('kpi_refund_pct')">
                        <div class="o_kpi_label">Returns Impact %</div>
                        <div class="o_kpi_value"><t t-esc="formatPercent(state.data.kpis.refund_pct)"/></div>
                    </div>
                    <div class="o_kpi" t-on-click="() => this.openKpiDetails('kpi_top_customer_share')">
                        <div class="o_kpi_label">Top 5 Customer Share</div>
                        <div class="o_kpi_value"><t t-esc="formatPercent(state.data.kpis.top_customer_share)"/></div>
                    </div>
                    <div class="o_kpi" t-on-click="() => this.openKpiDetails('kpi_new_customers')">
                        <div class="o_kpi_label">New Customers</div>
                        <div class="o_kpi_value"><t t-esc="formatNumber(state.data.kpis.new_customers)"/></div>
                    </div>
                    <div class="o_kpi" t-on-click="() => this.openKpiDetails('kpi_returning_customers')">
                        <div class="o_kpi_label">Returning Customers</div>
                        <div class="o_kpi_value"><t t-esc="formatNumber(state.data.kpis.returning_customers)"/></div>
                    </div>
                    <div class="o_kpi" t-on-click="() => this.openKpiDetails('kpi_avg_days_to_invoice')">
                        <div class="o_kpi_label">Avg Days to Invoice</div>
                        <div class="o_kpi_value"><t t-esc="formatNumber(state.data.kpis.avg_days_to_invoice)"/></div>
                    </div>
                    <div class="o_kpi" t-on-click="() => this.openKpiDetails('kpi_avg_days_to_pay')">
                        <div class="o_kpi_label">Avg Days to Pay</div>
                        <div class="o_kpi_value"><t t-esc="formatNumber(state.data.kpis.avg_days_to_pay)"/></div>
                    </div>
                    <div class="o_kpi" t-on-click="() => this.openKpiDetails('kpi_margin')">
                        <div class="o_kpi_label">Gross Margin</div>
                        <div class="o_kpi_value"><t t-esc="formatCurrency(state.data.kpis.margin_total)"/></div>
                        <div class="o_kpi_sub">Margin %: <t t-esc="formatPercent(state.data.kpis.margin_pct)"/></div>
                    </div>
                </div>

                <div class="o_sales_charts">
                    <div class="o_chart_card">
                        <div class="o_chart_title">Sales Orders (Last 12 Months) <span class="o_chart_hint">Click a value</span></div>
                        <div t-ref="soChart" class="o_chart"></div>
                    </div>
                    <div class="o_chart_card">
                        <div class="o_chart_title">Sales Invoices (Last 12 Months) <span class="o_chart_hint">Click a value</span></div>
                        <div t-ref="invChart" class="o_chart"></div>
                    </div>
                    <div class="o_chart_card">
                        <div class="o_chart_title">Historical (Old) Sales (Last 12 Months) <span class="o_chart_hint">Click a value</span></div>
                        <div t-ref="oldChart" class="o_chart"></div>
                    </div>
                    <div class="o_chart_card">
                        <div class="o_chart_title">Invoice Payment States <span class="o_chart_hint">Click a value</span></div>
                        <div t-ref="payChart" class="o_chart"></div>
                    </div>
                    <div class="o_chart_card">
                        <div class="o_chart_title">Top Customers (Sales Orders) <span class="o_chart_hint">Click a value</span></div>
                        <div t-ref="topChart" class="o_chart"></div>
                    </div>
                    <div class="o_chart_card">
                        <div class="o_chart_title">Top Items <span class="o_chart_hint">Click a value</span></div>
                        <div t-ref="itemsChart" class="o_chart"></div>
                    </div>
                    <div class="o_chart_card">
                        <div class="o_chart_title">Top Categories <span class="o_chart_hint">Click a value</span></div>
                        <div t-ref="catChart" class="o_chart"></div>
                    </div>
                    <div class="o_chart_card">
                        <div class="o_chart_title">Container Type Mix <span class="o_chart_hint">Click a value</span></div>
                        <div t-ref="containerChart" class="o_chart"></div>
                    </div>
                    <div class="o_chart_card">
                        <div class="o_chart_title">Invoice Aging Buckets <span class="o_chart_hint">Click a value</span></div>
                        <div t-ref="agingChart" class="o_chart"></div>
                    </div>
                    <div class="o_chart_card">
                        <div class="o_chart_title">Paid vs Open (Monthly) <span class="o_chart_hint">Click a value</span></div>
                        <div t-ref="paidOpenChart" class="o_chart"></div>
                    </div>
                    <div class="o_chart_card">
                        <div class="o_chart_title">Refunds Trend <span class="o_chart_hint">Click a value</span></div>
                        <div t-ref="refundChart" class="o_chart"></div>
                    </div>
                    <div class="o_chart_card">
                        <div class="o_chart_title">Gross Margin Trend <span class="o_chart_hint">Click a value</span></div>
                        <div t-ref="marginChart" class="o_chart"></div>
                    </div>
                    <div class="o_chart_card">
                        <div class="o_chart_title">Customer Cohort (New vs Returning) <span class="o_chart_hint">Click a value</span></div>
                        <div t-ref="cohortChart" class="o_chart"></div>
                    </div>
                    <div class="o_chart_card">
                        <div class="o_chart_title">Sales by Salesperson <span class="o_chart_hint">Click a value</span></div>
                        <div t-ref="salespersonChart" class="o_chart"></div>
                    </div>
                    <div class="o_chart_card">
                        <div class="o_chart_title">Sales by Brand <span class="o_chart_hint">Click a value</span></div>
                        <div t-ref="brandChart" class="o_chart"></div>
                    </div>
                    <div class="o_chart_card">
                        <div class="o_chart_title">Sales by Country <span class="o_chart_hint">Click a value</span></div>
                        <div t-ref="countryChart" class="o_chart"></div>
                    </div>
                    <div class="o_chart_card">
                        <div class="o_chart_title">Sales by Port <span class="o_chart_hint">Click a value</span></div>
                        <div t-ref="portChart" class="o_chart"></div>
                    </div>
                    <div class="o_chart_card">
                        <div class="o_chart_title">Top Payment Terms <span class="o_chart_hint">Click a value</span></div>
                        <div t-ref="termsChart" class="o_chart"></div>
                    </div>
                </div>

                <t t-if="state.showDetail">
                    <div class="o_sales_detail_overlay" t-on-click="onDetailOverlayClick">
                        <div class="o_sales_detail_dialog">
                            <div class="o_sales_detail_header">
                                <div>
                                    <h2 class="o_sales_detail_title"><t t-esc="state.detail and state.detail.title or 'Details'"/></h2>
                                </div>
                                <button type="button" class="btn btn-secondary btn-sm" t-on-click="closeDetail">Close</button>
                            </div>
                            <t t-if="state.detail and state.detail.loading">
                                <div class="o_sales_detail_loading">Loading source records...</div>
                            </t>
                            <t t-elif="state.detail">
                                <div class="o_sales_detail_explanation" t-esc="state.detail.explanation"/>
                                <div class="o_sales_detail_summary">
                                    <div class="o_sales_detail_stat">
                                        <div class="o_kpi_label"><t t-esc="state.detail.count_label or 'Records'"/></div>
                                        <div class="o_sales_detail_stat_value"><t t-esc="formatNumber(state.detail.count)"/></div>
                                    </div>
                                    <div class="o_sales_detail_stat">
                                        <div class="o_kpi_label"><t t-esc="state.detail.amount_label or 'Total Amount'"/></div>
                                        <div class="o_sales_detail_stat_value"><t t-esc="formatCurrency(state.detail.amount)"/></div>
                                    </div>
                                    <t t-if="state.detail.model">
                                        <button type="button" class="btn btn-primary btn-sm" t-on-click="openAllDetailRecords">Open all records</button>
                                    </t>
                                </div>
                                <t t-if="state.detail.truncated">
                                    <div class="o_sales_detail_note">Showing <t t-esc="state.detail.shown"/> of <t t-esc="state.detail.count"/> records. Open all records to see the full list.</div>
                                </t>
                                <div class="o_sales_detail_table_wrap">
                                    <table class="o_sales_detail_table">
                                        <thead>
                                            <tr>
                                                <th>Name</th>
                                                <th>Date</th>
                                                <th>Customer</th>
                                                <th class="o_sales_detail_num">Amount</th>
                                                <th>Detail</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="state.detail.rows or []" t-as="row" t-key="row.id">
                                                <tr t-att-data-id="row.id" t-on-click="openDetailRecord">
                                                    <td><t t-esc="row.name"/></td>
                                                    <td><t t-esc="row.date"/></td>
                                                    <td><t t-esc="row.partner"/></td>
                                                    <td class="o_sales_detail_num"><t t-esc="formatCurrency(row.amount)"/></td>
                                                    <td><t t-esc="row.extra"/></td>
                                                </tr>
                                            </t>
                                            <t t-if="!(state.detail.rows and state.detail.rows.length)">
                                                <tr>
                                                    <td colspan="5" class="o_sales_detail_empty">No source records found for this value.</td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </t>
                        </div>
                    </div>
                </t>
            </t>
            </div>
        </Layout>
    </t>
</templates>
