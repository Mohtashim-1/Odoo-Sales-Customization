<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_fetch_daily_currency_rates" model="ir.cron">
        <field name="name">Sales: Fetch Daily Currency Rates</field>
        <field name="model_id" ref="base.model_res_currency"/>
        <field name="state">code</field>
        <field name="code">model.cron_fetch_daily_exchange_rates()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>

    <record id="action_fetch_currency_rates_now" model="ir.actions.server">
        <field name="name">Fetch Live Exchange Rates</field>
        <field name="model_id" ref="base.model_res_currency"/>
        <field name="binding_model_id" ref="base.model_res_currency"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = model.action_fetch_exchange_rates_now()</field>
    </record>
</odoo>
