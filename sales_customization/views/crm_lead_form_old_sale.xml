<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="crm_lead_view_form_inherit_old_sale" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.old.sale</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_sync_partner_from_lead"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-refresh"
                    string="Sync to Customer"
                    invisible="not partner_id"
                />
                <button
                    name="action_open_customer_dashboard"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-bar-chart"
                    string="Customer Dashboard"
                    invisible="not partner_id"
                />
            </xpath>
            <xpath expr="//header" position="inside">
                <button
                    name="action_sync_partner_from_lead"
                    type="object"
                    string="Sync to Customer"
                    class="btn-secondary"
                    invisible="not partner_id"
                    confirm="Copy address, phone, email, and related fields from this lead to the customer record?"
                />
                <button
                    name="action_open_customer_dashboard"
                    type="object"
                    string="Customer Dashboard"
                    class="btn-secondary"
                    invisible="not partner_id"
                />
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Old Sales">
                    <div class="d-flex justify-content-end align-items-baseline gap-2 mb-2">
                        <span class="text-muted">Total invoice value</span>
                        <field name="old_sale_invoice_total" readonly="1" class="fw-bold"/>
                    </div>
                    <field name="old_sale_ids" context="{'default_lead_id': active_id}">
                        <!-- tree (not list): embedded o2many subview must use tree root or fields validate against parent model. -->
                        <!-- Monetary sum needs currency_id in arch activeFields. -->
                        <tree editable="bottom">
                            <field name="currency_id" column_invisible="True"/>
                            <field name="old_sales"/>
                            <field name="invoice_date"/>
                            <field name="invoice_number"/>
                            <field name="invoice_value" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Total"/>
                        </tree>
                        <form>
                            <group>
                                <field name="old_sales"/>
                                <field name="invoice_date"/>
                                <field name="invoice_number"/>
                                <field name="invoice_value"/>
                            </group>
                        </form>
                    </field>
                </page>
                <page string="Dashboard">
                    <div style="width: 100%; margin-top: 8px;">
                        <field name="total_sales_orders_html" widget="html" readonly="1" nolabel="1"/>
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
