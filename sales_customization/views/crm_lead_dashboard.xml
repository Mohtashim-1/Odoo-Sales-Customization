<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_graph_dashboard_stage" model="ir.ui.view">
        <field name="name">crm.lead.graph.dashboard.stage</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <graph string="Pipeline by Stage" type="bar" stacked="True">
                <field name="stage_id" type="row"/>
                <field name="expected_revenue" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="crm_lead_view_graph_dashboard_team" model="ir.ui.view">
        <field name="name">crm.lead.graph.dashboard.team</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <graph string="Pipeline by Team" type="bar" stacked="True">
                <field name="team_id" type="row"/>
                <field name="expected_revenue" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_crm_lead_charts_dashboard" model="ir.actions.act_window">
        <field name="name">CRM Charts (by Stage)</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">graph,pivot,tree,form</field>
        <field name="domain">[('type', '=', 'opportunity'), ('active', '=', True)]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Pipeline analytics</p>
            <p>Use Graph for a quick chart; open Pivot to slice by team, salesperson, tags, etc.</p>
        </field>
    </record>

    <record id="action_crm_lead_charts_dashboard_view_graph" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="crm_lead_view_graph_dashboard_stage"/>
        <field name="act_window_id" ref="action_crm_lead_charts_dashboard"/>
    </record>

    <record id="action_crm_lead_charts_dashboard_view_pivot" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="crm.crm_lead_view_pivot"/>
        <field name="act_window_id" ref="action_crm_lead_charts_dashboard"/>
    </record>

    <record id="action_crm_lead_charts_dashboard_view_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="crm.crm_case_tree_view_oppor"/>
        <field name="act_window_id" ref="action_crm_lead_charts_dashboard"/>
    </record>

    <record id="action_crm_lead_charts_dashboard_by_team" model="ir.actions.act_window">
        <field name="name">CRM Charts (by Team)</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">graph,pivot,tree</field>
        <field name="domain">[('type', '=', 'opportunity'), ('active', '=', True)]</field>
        <field name="view_id" ref="crm_lead_view_graph_dashboard_team"/>
    </record>

    <menuitem
        id="menu_crm_charts_dashboard"
        name="Charts Dashboard"
        parent="crm.crm_menu_sales"
        action="action_crm_lead_charts_dashboard"
        sequence="25"/>

    <menuitem
        id="menu_crm_charts_by_team"
        name="Charts (by Team)"
        parent="crm.crm_menu_sales"
        action="action_crm_lead_charts_dashboard_by_team"
        sequence="26"/>
</odoo>
