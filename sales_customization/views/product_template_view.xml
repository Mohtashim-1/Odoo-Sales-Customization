    <record id="view_product_form_custom" model="ir.ui.view">
        <field name="name">product.template.form.custom</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_standard_price']" position="inside">
                <field name="export_category_tag_id" options="{'no_create_edit': True}"/>
                <separator string="Barcode options"/>
                <field name="unit_barcode"/>
                <field name="case_barcode"/>
                <field name="launch_date" tracking="True" />
                <field name="product_code" tracking="True" />
                <field name="hs_code_id" tracking="True" />
                <field name="packaging_detail_id" tracking="True" />
                <field name="packaging_weight" />
                <field name="packaging_no_of_pc" />
                <field name="packaging_cartoon" />
                <field name="length" tracking="True" />
                <field name="width" tracking="True" />
                <field name="height" tracking="True" />
                <field name="net_weight" tracking="True" />
                <field name="gross_weight" tracking="True" />
                <field name="cbm" tracking="True" />
                <field name="order_cbm" tracking="True" />
                <field name="fcl_20" tracking="True" />
                <field name="fcl_40" tracking="True" />
                <field name="shelf_life" tracking="True" />
                <!-- <field name="lbs" tracking="True" /> -->
            </xpath>
        </field>
    </record>
    <record id="view_product_tree_custom" model="ir.ui.view">
        <field name="name">product.template.tree.custom</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="export_category_tag_id" optional="show"/>
                <field name="unit_barcode" optional="hide"/>
                <field name="case_barcode" optional="hide"/>
                <field name="launch_date"/>
                <field name="product_code"/>
                <field name="hs_code_id"/>
                <field name="packaging_detail_id"/>
                <field name="packaging_weight"/>
                <field name="packaging_no_of_pc"/>
                <field name="packaging_cartoon"/>
                <field name="length"/>
                <field name="width"/>
                <field name="height"/>
                <field name="net_weight"/>
                <field name="gross_weight"/>
                <field name="cbm"/>
                <field name="order_cbm"/>
                <field name="fcl_20"/>
                <field name="fcl_40"/>
                <field name="shelf_life"/>
            </xpath>
        </field>
    </record>

    <record id="view_product_product_form_barcode" model="ir.ui.view">
        <field name="name">product.product.form.barcode.custom</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <separator string="Barcode options"/>
                <field name="unit_barcode"/>
                <field name="case_barcode"/>
            </xpath>
        </field>
    </record>
</odoo>