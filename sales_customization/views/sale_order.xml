<?xml version="1.0" encoding="utf-8"?>
<odoo>
      <!-- 1) Limit partner_id to your own partner for that group -->
    


    <!-- Custom Details Page -->
    <record id="view_order_form_custom_details" model="ir.ui.view">
        <field name="name">sale.order.form.custom.details</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Other Details" name="other_details" groups="bn_sale_security.sales_user_group">
                    <group>
                        <group string="Product Information">
                            <field name="user_id"/>
                            <!-- <field name="assignee_id" /> -->
                            <field name="assignee_ids" widget="many2many_tags"/>
                            <field name="label_name"/>
                            <field name="manufactory_date"/>
                            <field name="expiry_date"/>
                            <field name="best_before"/>
                            <field name="print_instruction"/>
                        </group>
                        <group string="Shipping Details">
                            <field name="destination"/>
                            <field name="delivery"/>
                            <field name="container_arrival_date"/>
                            <field name="fda"/>
                            <field name="container_cbm"/>
                        </group>
                        <group string="Documentation">
                            <field name="fi_number"/>
                            <field name="fi_date"/>
                            <field name="bl_no"/>
                            <field name="bl_date"/>
                            <field name="vessel_voyage"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Main Inherited View -->
    <record id="view_order_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Hide elements -->
            <field name="state" position="attributes">
                <attribute name="invisible">1</attribute> 
            </field>
            
            <xpath expr="//button[@name='action_open_discount_wizard']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='payment_term_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Field groups after partner_id -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="company_id"
                       readonly="state not in ['draft', 'sent']"
                       options="{'no_create': True, 'no_open': True}"/>
                <field name="partner_code" groups="bn_sale_security.sales_user_group"/>
                <field name="required_date" groups="bn_sale_security.sales_user_group"/>
                <field name="customer_container" groups="bn_sale_security.sales_user_group"/>
                <field name="container_type"/>
                <field name="signature_type" groups="bn_sale_security.sales_user_group"/>
                <field name="export_order_category_tags" groups="bn_sale_security.sales_user_group" widget="many2many_tags" placeholder="Select tags to print on Export Order"/>
                <field name="pi_no" groups="bn_sale_security.sales_user_group"/>
                <field name="payment_term_id" groups="bn_sale_security.sales_user_group"/>
                <field name="shipping_line" groups="bn_sale_security.sales_user_group"/>
                <field name="shipment" groups="bn_sale_security.sales_user_group"/>
                <field name="order_date" groups="bn_sale_security.sales_user_group"/>
                <field name="container_arrival_date" groups="bn_sale_security.sales_user_group"/>
                <field name="container_no" groups="bn_sale_security.sales_user_group"/>
                <field name="container_cbm" groups="bn_sale_security.sales_user_group"/>
                <field name="validity" groups="bn_sale_security.sales_user_group"/>
                <field name="total_gross_weight"/>
                <field name="total_net_weight" groups="bn_sale_security.sales_user_group"/>
                <field name="total_cbm" groups="bn_sale_security.sales_user_group"/>
                <field name="total_order_cbm"/>
                <field name="total_in_words" groups="bn_sale_security.sales_user_group"/>
            </xpath>

            <!-- Second group of fields -->
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="label_name" groups="bn_sale_security.sales_user_group"/>
                <field name="manufactory_date" groups="bn_sale_security.sales_user_group"/>
                <field name="expiry_date" groups="bn_sale_security.sales_user_group"/>
                <field name="best_before" groups="bn_sale_security.sales_user_group"/>
                <field name="print_instruction" groups="bn_sale_security.sales_user_group"/>
                <field name="destination" groups="bn_sale_security.sales_user_group"/>
                <field name="delivery" groups="bn_sale_security.sales_user_group"/>
                

                <field name="fda" groups="bn_sale_security.sales_user_group"/>
                <field name="fi_number" groups="bn_sale_security.sales_user_group"/>
                <field name="fi_date" groups="bn_sale_security.sales_user_group"/>
                <field name="container_cbm" groups="bn_sale_security.sales_user_group"/>
                <field name="bl_no" groups="bn_sale_security.sales_user_group"/>
                <field name="bl_date" groups="bn_sale_security.sales_user_group"/>
                <field name="vessel_voyage" groups="bn_sale_security.sales_user_group"/>
            </xpath>

            <!-- Hide tax totals -->
            <xpath expr="//field[@name='tax_totals']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Fields before tax_totals -->
            <xpath expr="//field[@name='tax_totals']" position="before">
                <field name="freight" groups="bn_sale_security.sales_user_group"/>
                <field name="total_qty"/>
                <field name="gross_total"/>
                <field name="discount" groups="bn_sale_security.sales_user_group"/>
                <field name="discount_reason" groups="bn_sale_security.sales_user_group" />
                <field name="credit_note_amount" groups="bn_sale_security.sales_user_group" />
                <field name="credit_note_description" groups="bn_sale_security.sales_user_group"/>
                
                <field name="total"/>
            </xpath>

            <!-- Chatter control -->
            <xpath expr="//div[@class='oe_chatter']" position="replace">
                <group groups="bn_sale_security.sales_user_group">
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </group>
                <group groups="!bn_sale_security.sales_user_group">
                    <div/>
                </group>
            </xpath>

            <!-- Order line controls -->
            <xpath expr="//sheet//field[@name='order_line']/tree//control" position="replace">
                <control>
                    <create name="add_product_control" string="Add a product"/>
                    <create name="add_section_control" string="Add a section" context="{'default_display_type': 'line_section'}" groups="bn_sale_security.sales_user_group"/>
                    <create name="add_note_control" string="Add a note" context="{'default_display_type': 'line_note'}" groups="bn_sale_security.sales_user_group"/>
                    <button name="action_add_from_catalog" string="Catalog" type="object" class="px-4 btn-link" context="{'order_id': parent.id}"/>
                </control>
            </xpath>

            <!-- Block quick-create of products from quotation order lines -->
            <xpath expr="//field[@name='order_line']/tree//field[@name='product_id']" position="attributes">
                <attribute name="options">{'no_open': True, 'no_create': True, 'no_quick_create': True, 'no_create_edit': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree//field[@name='product_template_id']" position="attributes">
                <attribute name="options">{'no_open': True, 'no_create': True, 'no_quick_create': True, 'no_create_edit': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='product_id']" position="attributes">
                <attribute name="options">{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}</attribute>
            </xpath>

            <!-- Order line fields -->
            <xpath expr="//field[@name='order_line']/tree/field[@name='product_template_id']" position="after">
                <field name="launch_date" optional="show" groups="bn_sale_security.sales_user_group"/>
                <field name="categ_id_name" optional="show" groups="bn_sale_security.sales_user_group"/>
                <field name="image" widget="image" options="{'size': [40, 40]}" optional="show" groups="bn_sale_security.sales_user_group"/>
                <field name="hs_code_id" optional="show" groups="bn_sale_security.sales_user_group"/>
                <field name="packaging_detail_id" optional="show" groups="bn_sale_security.sales_user_group"/>
                <field name="pkts" optional="show" groups="bn_sale_security.sales_user_group"/>
                <field name="no_of_pieces" optional="show" groups="bn_sale_security.sales_user_group"/>
                <field name="length" optional="show" groups="bn_sale_security.sales_user_group"/>
                <field name="width" optional="show" groups="bn_sale_security.sales_user_group"/>
                <field name="height" optional="show" groups="bn_sale_security.sales_user_group"/>
                <field name="net_weight" optional="show" groups="bn_sale_security.sales_user_group"/>
                <field name="gross_weight" optional="show" groups="bn_sale_security.sales_user_group"/>
                <field name="cbm" optional="show" groups="bn_sale_security.sales_user_group"/>
                <field name="order_cbm" optional="show" groups="bn_sale_security.sales_user_group"/>
                <field name="fcl_20" optional="show" groups="bn_sale_security.sales_user_group"/>
                <field name="fcl_40" optional="show" groups="bn_sale_security.sales_user_group"/>
                <field name="shelf_life" optional="show" groups="bn_sale_security.sales_user_group"/>
                <field name="custom_price" optional="show" groups="bn_sale_security.sales_user_group"/>
                <field name="custom_amount" optional="show" groups="bn_sale_security.sales_user_group"/>
                <field name="no_of_ctn" optional="show" groups="bn_sale_security.sales_user_group"/>
                <field name="lbs_oz" optional="show" groups="bn_sale_security.sales_user_group"/>
                <field name="status" optional="show" groups="bn_sale_security.sales_user_group"/>
                <field name="description" optional="show" groups="bn_sale_security.sales_user_group"/>
                <field name="analysis" groups="bn_sale_security.sales_user_group"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='price_unit']" position="before">
                <field name="can_edit_sale_rates" column_invisible="1"/>
            </xpath>

            <xpath expr="//field[@name='order_line']/tree/field[@name='price_unit']" position="attributes">
                <attribute name="readonly">not can_edit_sale_rates</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']/form//field[@name='price_unit']" position="before">
                <field name="can_edit_sale_rates" invisible="1"/>
            </xpath>

            <xpath expr="//field[@name='order_line']/form//field[@name='price_unit']" position="attributes">
                <attribute name="readonly">not can_edit_sale_rates</attribute>
            </xpath>


            <xpath expr="//field[@name='order_line']/tree/field[@name='discount']" position="attributes">
                <attribute name="groups">bn_sale_security.sales_user_group</attribute>
            </xpath>
            
            <xpath expr="//field[@name='order_line']/tree/field[@name='tax_id']" position="replace"/>
        </field>
    </record>


<record id="hide_other_info_page" model="ir.ui.view">
    <field name="name">hide.other.info.page</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
        <!-- Only modify the page we want to hide -->
        <page name="other_information" position="attributes">
            <attribute name="invisible">1</attribute>
        </page> 

        <page name="optional_products" position="attributes">
            <attribute name="invisible">1</attribute>
        </page>

    </field>
</record>
</odoo>