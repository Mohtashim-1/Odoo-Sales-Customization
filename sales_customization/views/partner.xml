<record id="res_partner_form_custom_save" model="ir.ui.view">
    <field name="name">res.partner.form.custom.save</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
        <!-- Insert Save button right before the form fields (inside form but before sheet) -->
        <xpath expr="//form/sheet" position="before">
            <!-- <div class="oe_title"> -->
            <div class="oe_title oe_edit_only" style="margin-bottom: 2px;">
                <button 
                    name="action_custom_save" 
                    type="object" 
                    class="btn-primary" 
                    string="Save" 
                    icon="fa-save"
                />
            </div>
        </xpath>
    </field>
</record>



</odoo>
