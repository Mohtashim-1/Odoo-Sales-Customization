<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <!-- Record Rule: customers only see their own contact -->
    <record id="rule_partner_only_own_contact" model="ir.rule">
      <field name="name">Partner: only own contact</field>
      <field name="model_id" ref="base.model_res_partner"/>
      <!-- Only partners whose user_id equals the logged-in user -->
      <!-- Allow internal partners; restrict shared partners to own contact -->
      <field name="domain_force">['|', ('partner_share','=', False), ('user_id','=', user.id)]</field>
      <!-- Applies only to your customer group -->
      <field name="groups" eval="[(4, ref('sales_customization.sales_customer_group'))]"/>
    </record>
  </data>
</odoo>
