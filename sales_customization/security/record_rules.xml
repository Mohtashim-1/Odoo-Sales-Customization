<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">

        <!-- Full access to res.partner for Sale/Document Group -->
        <record id="access_res_partner_document_group" model="ir.model.access">
            <field name="name">res.partner access for Sale/Document Group</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="group_id" ref="sales_customization.sales_document_group"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="access_res_users_document_group" model="ir.model.access">
            <field name="name">res.users read access for Sale/Document Group</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="group_id" ref="sales_customization.sales_document_group"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="access_sale_order_line_document_group" model="ir.model.access">
            <field name="name">sale.order.line access for Sale/Document Group</field>
            <field name="model_id" ref="sale.model_sale_order_line"/>
            <field name="group_id" ref="sales_customization.sales_document_group"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="sale_order_line_access_for_document_group" model="ir.rule">
            <field name="name">Sale Order Line - Full Access for Document Group</field>
            <field name="model_id" ref="sale.model_sale_order_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sales_customization.sales_document_group'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="sale_order_access_for_document_group" model="ir.rule">
            <field name="name">Sales Order - Full Access for Document Group</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sales_customization.sales_document_group'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Override Sale's personal rule to hide unassigned orders -->
        <record id="sale.sale_order_personal_rule" model="ir.rule">
            <field name="domain_force">[('user_id', '=', user.id)]</field>
        </record>

    </data>

    <!-- noupdate="0": always re-applied on module upgrade -->
    <data noupdate="0">

        <!-- Model access: Sales Customer Group can read res.users (needed on login) -->
        <record id="access_res_users_sales_customer_group" model="ir.model.access">
            <field name="name">res.users read access for Sales Customer Group</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="group_id" ref="sales_customization.sales_customer_group"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="access_sale_order_line_sales_customer_group" model="ir.model.access">
            <field name="name">sale.order.line access for Sales Customer Group</field>
            <field name="model_id" ref="sale.model_sale_order_line"/>
            <field name="group_id" ref="sales_customization.sales_customer_group"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Record rule: Sales Customer Group can read all res.users records (required for login and relational fields) -->
        <record id="rule_res_users_read_all_sales_customer_group" model="ir.rule">
            <field name="name">Users: read all for Sales Customer Group</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sales_customization.sales_customer_group'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Record rule: Sales Customer Group full access on sale.order.line
             Without this, the 'Personal Order Lines' rule (User: Own Documents Only)
             blocks create/write when salesman_id is set to a different user. -->
        <record id="rule_sale_order_line_sales_customer_group" model="ir.rule">
            <field name="name">Sale Order Line - Full Access for Sales Customer Group</field>
            <field name="model_id" ref="sale.model_sale_order_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sales_customization.sales_customer_group'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

    </data>

</odoo>
