<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Override Sale's personal rule to hide unassigned orders -->
        <record id="sale.sale_order_personal_rule" model="ir.rule">
            <field name="domain_force">[('user_id', '=', user.id)]</field>
        </record>

        <!-- Let users read/write sale orders across all companies assigned to them,
             even when only one company is currently active in the UI context. -->
        <record id="sale.sale_order_comp_rule" model="ir.rule">
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', user.company_ids.ids)]</field>
        </record>

        <record id="sale.sale_order_line_comp_rule" model="ir.rule">
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', user.company_ids.ids)]</field>
        </record>

        <record id="sale.sale_order_report_comp_rule" model="ir.rule">
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', user.company_ids.ids)]</field>
        </record>
    </data>
</odoo>
