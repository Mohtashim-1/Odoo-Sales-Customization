<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend partner form with distributor tab -->
    <record id="view_partner_form_distributor" model="ir.ui.view">
        <field name="name">res.partner.form.distributor</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority" eval="1100"/>
        <field name="arch" type="xml">

            <!-- Distributor flag next to the partner name -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="is_distributor" widget="boolean_toggle"/>
            </xpath>

            <!-- Distributor reviewer used when creating distributor orders. -->
            <xpath expr="//page[@name='sales_purchases']//field[@name='user_ids']" position="after">
                <field name="is_distributor" invisible="1"/>
                <field name="distributor_salesperson_id"
                       string="Assigned Salesperson"
                       invisible="not is_distributor"/>
            </xpath>

            <!-- Smart button for distributor orders -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_distributor_orders"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-shopping-cart"
                        invisible="not is_distributor">
                    <field string="Orders" name="distributor_order_count" widget="statinfo"/>
                </button>
                <button name="action_view_distributor_portal_users"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-user"
                        invisible="not is_distributor"
                        groups="base.group_user">
                    <field string="Distributor users" name="distributor_portal_user_count" widget="statinfo"/>
                </button>
            </xpath>

        </field>
    </record>

</odoo>
