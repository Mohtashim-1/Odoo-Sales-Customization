<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════
         DISTRIBUTOR ORDER LINE – standalone list view
         (defined separately so the validator uses the correct model)
    ══════════════════════════════════════════════════════════════════ -->
    <record id="view_distributor_order_line_list" model="ir.ui.view">
        <field name="name">distributor.order.line.list</field>
        <field name="model">distributor.order.line</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="product_id"/>
                <field name="description"/>
                <field name="product_qty"/>
                <field name="product_uom_id"/>
                <field name="price_unit"/>
                <field name="price_subtotal" readonly="1" sum="Total"/>
            </tree>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════
         DISTRIBUTOR ORDER – Form View
    ══════════════════════════════════════════════════════════════════ -->
    <record id="view_distributor_order_form" model="ir.ui.view">
        <field name="name">distributor.order.form</field>
        <field name="model">distributor.order</field>
        <field name="arch" type="xml">
            <form string="Distributor Order">

                <!-- ── Header ──────────────────────────────────────── -->
                <header>
                    <button name="action_submit"
                            string="Submit for Approval"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"
                            confirm="Are you sure you want to submit this order for approval?"/>

                    <button name="action_approve"
                            string="Approve"
                            type="object"
                            class="btn-success"
                            invisible="state != 'submitted'"
                            groups="distributor_order.group_distributor_salesperson"
                            confirm="Approve this order and create a Sale Order?"/>

                    <button name="action_reject"
                            string="Reject"
                            type="object"
                            class="btn-danger"
                            invisible="state != 'submitted'"
                            groups="distributor_order.group_distributor_salesperson"/>

                    <button name="action_reset_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state != 'rejected'"/>

                    <button name="action_view_sale_order"
                            string="View Sale Order"
                            type="object"
                            class="btn-info"
                            invisible="not sale_order_id"/>

                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,sale_created"/>
                </header>

                <!-- ── Rejection alert ────────────────────────────── -->
                <div class="alert alert-warning mb-0" invisible="state != 'rejected'">
                    <strong>Rejected: </strong>
                    <field name="rejection_reason" readonly="1" nolabel="1"/>
                </div>

                <!-- ── Sheet ─────────────────────────────────────── -->
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sale_order"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-text-o"
                                invisible="not sale_order_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Sale Order</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <group>
                        <group string="Distributor Info">
                            <field name="can_edit_distributor_id" invisible="1"/>
                            <field name="can_edit_salesperson_id" invisible="1"/>
                            <field name="distributor_id"
                                   readonly="state != 'draft' or not can_edit_distributor_id"
                                   options="{'no_open': True, 'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                            <field name="salesperson_id"
                                   readonly="state != 'draft' or not can_edit_salesperson_id"
                                   options="{'no_open': True, 'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                            <field name="order_date" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Tracking">
                            <field name="submission_date" readonly="1"/>
                            <field name="approval_date" readonly="1"/>
                            <field name="sale_order_id" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Order Lines" name="order_lines">
                            <!-- reference the standalone tree view – no inline <tree> -->
                            <field name="order_line_ids"
                                   context="{'default_order_id': active_id}"/>

                            <group class="oe_subtotal_footer oe_right">
                                <field name="amount_total" widget="monetary"
                                       options="{'currency_field': 'currency_id'}"
                                       string="Total Amount"/>
                            </group>
                        </page>

                        <page string="Terms &amp; Notes" name="notes">
                            <field name="notes" readonly="state != 'draft'"/>
                        </page>
                    </notebook>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════
         DISTRIBUTOR ORDER – List View
    ══════════════════════════════════════════════════════════════════ -->
    <record id="view_distributor_order_list" model="ir.ui.view">
        <field name="name">distributor.order.list</field>
        <field name="model">distributor.order</field>
        <field name="arch" type="xml">
            <tree string="Distributor Orders"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'submitted'"
                  decoration-success="state in ('approved', 'sale_created')"
                  decoration-danger="state == 'rejected'">
                <field name="name"/>
                <field name="distributor_id"/>
                <field name="salesperson_id"/>
                <field name="order_date"/>
                <field name="amount_total" sum="Total" widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'submitted'"
                       decoration-success="state in ('approved', 'sale_created')"
                       decoration-danger="state == 'rejected'"/>
                <field name="sale_order_id" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════
         DISTRIBUTOR ORDER – Kanban View
    ══════════════════════════════════════════════════════════════════ -->
    <record id="view_distributor_order_kanban" model="ir.ui.view">
        <field name="name">distributor.order.kanban</field>
        <field name="model">distributor.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="distributor_id"/>
                <field name="salesperson_id"/>
                <field name="order_date"/>
                <field name="amount_total"/>
                <field name="state"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="distributor_id"/>
                                </div>
                                <div>
                                    <span class="text-muted">Salesperson: </span>
                                    <field name="salesperson_id"/>
                                </div>
                                <div>
                                    <span class="text-muted">Date: </span>
                                    <field name="order_date"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="amount_total" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════
         DISTRIBUTOR ORDER – Search View
    ══════════════════════════════════════════════════════════════════ -->
    <record id="view_distributor_order_search" model="ir.ui.view">
        <field name="name">distributor.order.search</field>
        <field name="model">distributor.order</field>
        <field name="arch" type="xml">
            <search string="Distributor Orders">
                <field name="name" string="Order Reference"/>
                <field name="distributor_id"/>
                <field name="salesperson_id"/>

                <filter string="Draft"        name="draft"        domain="[('state','=','draft')]"/>
                <filter string="Submitted"    name="submitted"    domain="[('state','=','submitted')]"/>
                <filter string="Approved"     name="approved"     domain="[('state','=','approved')]"/>
                <filter string="Rejected"     name="rejected"     domain="[('state','=','rejected')]"/>
                <filter string="Sale Created" name="sale_created" domain="[('state','=','sale_created')]"/>
                <separator/>
                <!--
                    "My Orders" should be visible to both:
                    - Distributor users (matched via distributor_id.user_ids)
                    - Salespersons (matched via salesperson_id)
                -->
                <filter string="My Orders"    name="my_orders"
                        domain="['|',('salesperson_id','=',uid),('distributor_id.user_ids','in',[uid])]"/>

                <group expand="0" string="Group By">
                    <filter string="Distributor" name="by_distributor" context="{'group_by': 'distributor_id'}"/>
                    <filter string="Salesperson" name="by_salesperson" context="{'group_by': 'salesperson_id'}"/>
                    <filter string="Status"      name="by_state"       context="{'group_by': 'state'}"/>
                    <filter string="Order Date"  name="by_date"        context="{'group_by': 'order_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════
         REJECTION WIZARD – Form View
    ══════════════════════════════════════════════════════════════════ -->
    <record id="view_distributor_order_reject_wizard_form" model="ir.ui.view">
        <field name="name">distributor.order.reject.wizard.form</field>
        <field name="model">distributor.order.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Distributor Order">
                <sheet>
                    <group>
                        <field name="order_id" readonly="1"/>
                        <field name="rejection_reason" required="1"
                               placeholder="Please provide a reason for rejection..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_rejection"
                            string="Confirm Rejection"
                            type="object"
                            class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════
         ACTIONS
    ══════════════════════════════════════════════════════════════════ -->

    <record id="action_distributor_order_all" model="ir.actions.act_window">
        <field name="name">Distributor Orders</field>
        <field name="res_model">distributor.order</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_distributor_order_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No distributor orders found.</p>
            <p>Create a new distributor order or wait for distributors to submit theirs.</p>
        </field>
    </record>

    <record id="action_distributor_order_pending" model="ir.actions.act_window">
        <field name="name">Pending Approval</field>
        <field name="res_model">distributor.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state','=','submitted')]</field>
        <field name="search_view_id" ref="view_distributor_order_search"/>
        <field name="context">{'search_default_my_orders': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No orders pending approval.</p>
        </field>
    </record>

    <record id="action_distributor_order_mine" model="ir.actions.act_window">
        <field name="name">My Orders</field>
        <field name="res_model">distributor.order</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_distributor_order_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No orders yet.</p>
            <p>Click <b>New</b> to create your first distributor order.</p>
        </field>
    </record>

</odoo>
