<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_distributor_order" model="ir.actions.report">
        <field name="name">Distributor Order</field>
        <field name="model">distributor.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">distributor_order.report_distributor_order</field>
        <field name="report_file">distributor_order.report_distributor_order</field>
        <field name="binding_model_id" ref="model_distributor_order"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <template id="report_distributor_order">
      <t t-call="web.html_container">
        <t t-foreach="docs" t-as="doc">
          <style>
                    table {
                        border: 1px solid black;
                        width: 100%;
                        border-collapse: collapse;
                    }
                    th, td {
                        padding: 8px;
                        text-align: left;
                        border: 1px solid black;
                    }
                    .header img {
                        width: 100%;
                        height: auto;
                    }

          </style>
          <div class="page" style="font-family: Arial, sans-serif; margin: 0; padding: 30px;">
            <div class="header" style="text-align: center; margin-bottom: 30px;">
              <div>
                <img t-if="doc.company_id.image_field_1" t-att-src="image_data_uri(doc.company_id.image_field_1)" alt="Company Logo" style="width: 100%; max-width: 210mm; height: 30mm;" />
              </div>
            </div>

            <div class="footer">
              <t t-if="doc.company_id.name == 'Vital Products (Pvt.) Ltd.'">
                <img t-if="doc.company_id.image_field_2"
                     t-att-src="image_data_uri(doc.company_id.image_field_2)"
                     alt="Footer Logo"
                     style="width: 100%; max-width: 240mm; height: " />
              </t>
              <t t-else="">
                <img t-if="doc.company_id.image_field_2"
                     t-att-src="image_data_uri(doc.company_id.image_field_2)"
                     alt="Footer Logo"
                     style="width: 100%; max-width: 240mm; height: auto; padding-top: 15px !important; " />
              </t>
            </div>

            <h1 style="font-size: 24px; font-weight: bold;">Distributor Order</h1>

            <table style="width: 100%; border-spacing: 0; font-size:11pt">
                <tr>
                    <td style="width: 48%; vertical-align: top; padding-right: 5%; font-size:11pt">
                        <table style="width: 100%; border-spacing: 0; font-size:11pt">
                            <tr>
                                                                <td style="width: 40%; padding-top: 10px;"><strong>Distributor:</strong></td>

                                <td style="padding-top: 10px;"><span t-esc="doc.distributor_id.display_name"/></td>

                            </tr>
                            <tr>
                                <td style="width: 40%; padding-top: 10px;"><strong>Invoice No:</strong></td>
                                <td style="padding-top: 10px;"><span t-esc="doc.name"/></td>
                            </tr>


                        </table>
                    </td>
                    <td style="width: 1%;"></td>
                    <td style="width: 50%; vertical-align: top; font-size:11pt">
                        <table style="width: 100%; border-spacing: 0; font-size:11pt">
                                                        <tr>
                                <td style="padding-top: 10px;"><strong>Salesperson:</strong></td>
                                <td style="padding-top: 10px;"><span t-esc="doc.salesperson_id.name"/></td>
                            </tr>

                                                        <tr>
                                <td style="padding-top: 10px;"><strong>Date:</strong></td>
                                <td style="padding-top: 10px;"><span t-esc="doc.order_date.strftime('%d-%m-%Y')"/></td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>


            <t t-if="doc.order_line_ids">
              <table class="table table-condensed" style="width: 100%; border-collapse: collapse; margin-top: 10px; font-size:11pt">
                <thead>
                  <tr style="background-color: #C0C0C0;">
                    <th style="padding: 4px; border-bottom: 1px solid black;width:5px">S#</th>
                    <th style="padding: 4px; border-bottom: 1px solid black;">Image</th>
                    <th style="padding: 4px; border-bottom: 1px solid black;">Description</th>
                    <th style="padding: 4px; border-bottom: 1px solid black;">Qty</th>
                    <th style="padding: 4px; border-bottom: 1px solid black;">UoM</th>
                    <th style="padding: 4px; border-bottom: 1px solid black;">Unit Price</th>
                    <th style="padding: 4px; border-bottom: 1px solid black; text-align: right;">Amount</th>
                  </tr>
                </thead>
                <tbody>
                  <t t-set="sub_category_lst" t-value="[]" />
                  <t t-set="product_lst" t-value="[]" />
                  <t t-set="s_no" t-value="1" />
                  <t t-foreach="doc.order_line_ids" t-as="line">
                    <t t-if="line.product_id.categ_id.name not in sub_category_lst">
                      <t t-set="sub_category_lst" t-value="sub_category_lst + [line.product_id.categ_id.name]" />
                      <tr>
                        <td style="background-color:#EDEDED" />
                        <td style="background-color:#EDEDED" />
                        <td style="background-color: #EDEDED; text-align: left; width: 150px; ">
                          <strong>
                            <span t-esc="line.product_id.categ_id.name" />
                          </strong>
                        </td>
                        <td style="background-color:#EDEDED" />
                        <td style="background-color:#EDEDED" />
                        <td style="background-color:#EDEDED" />
                        <td style="background-color:#EDEDED" />
                      </tr>
                      <t t-foreach="doc.order_line_ids" t-as="sub_line">
                        <t t-if="sub_line.product_id.categ_id.name == line.product_id.categ_id.name and sub_line.product_id.id not in product_lst">
                          <t t-set="product_lst" t-value="product_lst + [sub_line.product_id.id]" />
                          <tr>
                            <td style="padding: 8px; border-bottom: 1px solid lightgrey; text-align: center; vertical-align: top;">
                              <span t-esc="s_no" />
                              <t t-set="s_no" t-value="s_no + 1" />
                            </td>
                            <td style="padding: 8px; border-bottom: 1px solid lightgrey; text-align: center; vertical-align: middle; width: 40px; height: 40px;">
                                <div style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 5px; background-color: #f9f9f9;">
                                    <img
                                        t-if="sub_line.product_id.image_128"
                                        t-att-src="image_data_uri(sub_line.product_id.image_128)"
                                        alt="Product Image"
                                        style="max-width: 100%; max-height: 100%; object-fit: contain; border-radius: 5px;"
                                    />
                                </div>
                            </td>
                            <td style="padding: 8px; border-bottom: 1px solid lightgrey; text-align: left;vertical-align: top;">
                              <span t-esc="sub_line.description or sub_line.product_id.display_name" />
                            </td>
                            <td style="padding: 8px; border-bottom: 1px solid lightgrey; text-align: center;vertical-align: top;">
                              <span t-esc="'{:.0f}'.format(sub_line.product_qty)" />
                            </td>
                            <td style="padding: 8px; border-bottom: 1px solid lightgrey; text-align: center;vertical-align: top;">
                              <span t-esc="sub_line.product_uom_id.name" />
                            </td>
                            <td style="padding: 8px; border-bottom: 1px solid lightgrey; text-align: center; width: 10%;vertical-align: top;">
                              $ <span t-esc="'{:.2f}'.format(sub_line.price_unit)" />
                            </td>
                            <td style="padding: 8px; border-bottom: 1px solid lightgrey; text-align: right; width: 13%;vertical-align: top;">
                              $ <span t-esc="'{:.2f}'.format(sub_line.price_subtotal)" />
                            </td>
                          </tr>
                        </t>
                      </t>
                    </t>
                  </t>
                </tbody>
              </table>
            </t>
          </div>
        </t>
      </t>
    </template>

</odoo>
