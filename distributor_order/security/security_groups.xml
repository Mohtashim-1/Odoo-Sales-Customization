<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ─── Category ─────────────────────────────────────────────── -->
    <record id="module_category_distributor" model="ir.module.category">
        <field name="name">Distributor</field>
        <field name="description">Manage distributor orders and approvals.</field>
        <field name="sequence">20</field>
    </record>

    <!-- ─── Groups ────────────────────────────────────────────────── -->

    <!-- Read product master data for lines + catalog (implied by Distributor User). -->
    <record id="group_distributor_catalog_reader" model="res.groups">
        <field name="name">Distributor User / Product catalog</field>
        <field name="category_id" ref="module_category_distributor"/>
        <field name="comment">Technical group: read access on product variants/templates (and related) for distributor orders. Automatically applied with Distributor User.</field>
    </record>

    <!-- Distributor User  – can create / view their own orders -->
    <record id="group_distributor_user" model="res.groups">
        <field name="name">Distributor User</field>
        <field name="category_id" ref="module_category_distributor"/>
        <!-- Do not imply base.group_user here: upgrading would push Internal onto users who still have Portal → "more than one user types". Internal User is added in code (res.partner _ensure_distributor_user). -->
        <field name="implied_ids" eval="[(4, ref('group_distributor_catalog_reader'))]"/>
        <field name="comment">Can create and view their own distributor orders. Assign together with Internal User (see automation on distributor contacts).</field>
    </record>

    <!-- Distributor Salesperson – can approve / reject orders assigned to them -->
    <record id="group_distributor_salesperson" model="res.groups">
        <field name="name">Distributor Salesperson</field>
        <field name="category_id" ref="module_category_distributor"/>
        <field name="implied_ids" eval="[(4, ref('group_distributor_user'))]"/>
        <field name="comment">Can approve or reject distributor orders and convert them to sale orders.</field>
    </record>

    <!-- Distributor Manager – full access -->
    <record id="group_distributor_manager" model="res.groups">
        <field name="name">Distributor Manager</field>
        <field name="category_id" ref="module_category_distributor"/>
        <field name="implied_ids" eval="[(4, ref('group_distributor_salesperson'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">Full access to all distributor orders.</field>
    </record>

</odoo>
